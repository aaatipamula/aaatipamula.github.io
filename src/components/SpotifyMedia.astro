---
import type { SpotifyImage } from '@util/spotify';

// import { Image } from 'astro:assets';
import { SpotifyClient } from "@util/spotify";

export interface DisplayItem {
  image: SpotifyImage | null;
  caption: string;
  link: string;
}

interface Props {
  // items: DisplayItem[];
  tracks?: string[]
  artists?: string[]
  albums?: string[]
}

const client = new SpotifyClient({
  clientId: import.meta.env.SPOTIFY_CLIENT_ID,
  clientSecret: import.meta.env.SPOTIFY_CLIENT_SECRET,
  redirectUri: import.meta.env.SPOTIFY_REDIRECT_URL,
  scopes: ["playlist-read-private"],
});

// Server auth
await client.authenticateAsApp();

function getImageMetaData(images: SpotifyImage[]): SpotifyImage {
  // const randImg = images[Math.floor(Math.random() * images.length)];
  const highestRes = images[0];

  return highestRes 
}

async function getArtistInfo(uri: string): Promise<DisplayItem> {
  const uriObj = new URL(uri);

  if (uriObj.host != "open.spotify.com") {
    throw new Error("Invalid spotify uri");
  }

  const trackId = uriObj.pathname.split("/").at(-1);

  if (!trackId) {
    throw new Error("No Track ID found.");
  }

  // Use placeholders for development to avoid rate-limits
  if (import.meta.env.DEV) {
    return {
      image: {url: "https://placehold.co/640x640", width: 640, height: 640},
      caption: "ARTIST - PLACEHOLDER",
      link: uri,
    } as DisplayItem;
  }

  const artist = await client.getArtist(trackId);

  return {
    image: artist.images ? getImageMetaData(artist.images) : null,
    caption: artist.name,
    link: uri,
  } as DisplayItem;
}

async function getTrackInfo(uri: string): Promise<DisplayItem> {
  const uriObj = new URL(uri);

  if (uriObj.host != "open.spotify.com") {
    throw new Error("Invalid spotify uri");
  }

  const trackId = uriObj.pathname.split("/").at(-1);

  if (!trackId) {
    throw new Error("No Track ID found.");
  }

  // Use placeholders for development to avoid rate-limits
  if (import.meta.env.DEV) {
    return {
      image: {url: "https://placehold.co/640x640", width: 640, height: 640},
      caption: "TRACK - PLACEHOLDER",
      link: uri,
    } as DisplayItem;
  }

  const track = await client.getTrack(trackId);

  return {
    image: getImageMetaData(track.album.images),
    caption: track.name,
    link: uri,
  } as DisplayItem;
}

async function getAlbumInfo(uri: string): Promise<DisplayItem> {
  const uriObj = new URL(uri);

  if (uriObj.host != "open.spotify.com") {
    throw new Error("Invalid spotify uri");
  }

  const albumId = uriObj.pathname.split("/").at(-1);

  if (!albumId) {
    throw new Error("No Track ID found.");
  }

  // Use placeholders for development to avoid rate-limits
  if (import.meta.env.DEV) {
    return {
      image: {url: "https://placehold.co/640x640", width: 640, height: 640},
      caption: "ALBUM - PLACEHOLDER",
      link: uri,
    } as DisplayItem;
  }

  const album = await client.getAlbum(albumId);

  return {
    image: album.images ? getImageMetaData(album.images) : null,
    caption: album.name,
    link: uri,
  } as DisplayItem;
}

const { tracks, artists, albums } = Astro.props;

let displayItems: DisplayItem[];

if (artists && tracks && albums) {
  throw new Error("Cannot define both artists and tracks!");
} else if (artists) {
  displayItems = await Promise.all(artists.map(getArtistInfo));
} else if (tracks) {
  displayItems = await Promise.all(tracks.map(getTrackInfo));
} else if (albums) {
  displayItems = await Promise.all(albums.map(getAlbumInfo));
} else {
  throw new Error("Must have at either tracks or artists displayed");
}
---

<div class="mosaic">
  <div class="mosaic-main">
    <a class="mosaic-frame" href={displayItems[0].link}>
      {displayItems[0].image && (
        <img class="mosaic-img" src={displayItems[0].image.url} width={displayItems[0].image.width} height={displayItems[0].image.height} alt=`img-${displayItems[0].caption}` />
      )}
      <div class="img-caption">{displayItems[0].caption}</div>
    </a>
  </div>
  <div class="mosaic-tiles">
    {displayItems.slice(1).map(item => (
    <div class="mosaic-tile">
      <a class="mosaic-frame" href={item.link}>
        {item.image && (
          <img class="mosaic-img" src={item.image.url} width={item.image.width} height={item.image.height} alt=`img-${item.caption}` />
        )}
        <div class="img-caption">{item.caption}</div>
      </a>
    </div>
    ))}
  </div>
</div>

<style>
.mosaic {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.75rem;
  text-align: center;
}

.mosaic-tiles {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.5rem;
  align-content: start;
}

.mosaic-frame {
  position: relative;
  display: block;
  overflow: hidden;
}

.mosaic-frame:hover {
  opacity: 1;
}

.mosaic-img {
  display: block;
  width: 100%;
  aspect-ratio: 1/1;
  object-fit: cover;
}

.img-caption {
  position: absolute;
  inset: auto 0 0 0;
  padding: 0.5rem;
  background: linear-gradient(to top, rgb(0 0 0 / 80%), transparent);
  color: #fff;
  font-size: 0.875rem;
  opacity: 0;
  transition: opacity 0.2s ease;
  pointer-events: none;
}

.mosaic-frame:hover .img-caption,
.mosaic-frame:focus-visible .img-caption {
  opacity: 1;
}

@media (max-width: 480px) {
  .mosaic {
    grid-template-columns: 1fr;
  }
}
</style>
